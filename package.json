{
  "name": "dsh-minimalist-worktree",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Two new-session controls: use the local checkout or start an isolated Git worktree from a selected branch.",
  "license": "MIT",
  "engines": { "dsh": "0.2.1-rc.5" },
  "keywords": ["dsh-plugin", "deepseek-harness", "git", "worktree"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "core.js", "git.js", "client.js", "src/client.js", "build.mjs", "test/*.test.mjs", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "dependencies": { "zod": "4.4.3" },
  "peerDependencies": { "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.5" },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-connection"]
    }
  }
}
